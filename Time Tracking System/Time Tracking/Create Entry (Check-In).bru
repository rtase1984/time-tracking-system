meta {
  name: Create Entry (Check-In)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/time-entries
  body: json
  auth: bearer
}

auth:bearer {
  token: {{jwt_token}}
}

body:json {
  {
      "entryType": "CHECK_IN",
      "entryTimestamp": "2024-03-20T08:00:00",
      "location": "Office",
      "notes": "Starting work"
  }
}

settings {
  encodeUrl: true
}
